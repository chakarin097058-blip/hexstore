# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
PORT=3000
NODE_ENV=production
# ตั้งเป็น 1 เมื่อรันหลัง nginx/Cloudflare (จำเป็นสำหรับ https และ rate limit ที่ถูกต้อง)
TRUST_PROXY=1
# บัญชีแอดมินคนแรก (สร้างอัตโนมัติตอนเริ่มระบบครั้งแรก ถ้ายังไม่มีแอดมิน) — ตั้งรหัสผ่านยาวๆ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=เปลี่ยนเป็นรหัสผ่านยาวๆของคุณ
# ลิงก์หลังบ้าน เช่น ADMIN_PATH=manage-x7k2 จะเข้าที่ https://โดเมนคุณ/manage-x7k2/
ADMIN_PATH=admin
# โฟลเดอร์เก็บฐานข้อมูล/รูป/สลิป (ค่าเริ่มต้น ./data) — ต้อง backup โฟลเดอร์นี้
# DATA_DIR=/var/lib/hexstore
